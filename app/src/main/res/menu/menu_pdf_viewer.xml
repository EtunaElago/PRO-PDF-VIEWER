<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android">

    <!-- Search in PDF Content -->
    <item
        android:id="@+id/action_search_in_pdf"
        android:icon="@drawable/ic_search"
        android:title="@string/search_in_pdf"
        app:showAsAction="ifRoom"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <!-- Bookmark Current Page -->
    <item
        android:id="@+id/action_bookmark"
        android:icon="@drawable/ic_bookmark"
        android:title="@string/bookmark"
        app:showAsAction="ifRoom" />

    <!-- Share PDF File -->
    <item
        android:id="@+id/action_share_pdf"
        android:icon="@drawable/ic_share"
        android:title="@string/share_pdf"
        app:showAsAction="ifRoom" />

    <!-- Print PDF -->
    <item
        android:id="@+id/action_print"
        android:icon="@drawable/ic_print"
        android:title="@string/print"
        app:showAsAction="ifRoom" />

    <!-- More Options for PDF -->
    <item
        android:id="@+id/action_more_options"
        android:icon="@drawable/ic_more_vert"
        android:title="@string/more_options"
        app:showAsAction="always">

        <menu>
            <!-- Zoom Settings -->
            <group android:id="@+id/group_zoom">
                <item
                    android:id="@+id/action_zoom_in"
                    android:title="@string/zoom_in" />
                <item
                    android:id="@+id/action_zoom_out"
                    android:title="@string/zoom_out" />
                <item
                    android:id="@+id/action_fit_width"
                    android:title="@string/fit_width" />
                <item
                    android:id="@+id/action_fit_height"
                    android:title="@string/fit_height" />
            </group>

            <!-- Page Navigation -->
            <group android:id="@+id/group_navigation">
                <item
                    android:id="@+id/action_go_to_page"
                    android:title="@string/go_to_page" />
                <item
                    android:id="@+id/action_first_page"
                    android:title="@string/first_page" />
                <item
                    android:id="@+id/action_last_page"
                    android:title="@string/last_page" />
            </group>

            <!-- Display Settings -->
            <group android:id="@+id/group_display">
                <item
                    android:id="@+id/action_night_mode"
                    android:checkable="true"
                    android:title="@string/night_mode" />
                <item
                    android:id="@+id/action_auto_scroll"
                    android:checkable="true"
                    android:title="@string/auto_scroll" />
                <item
                    android:id="@+id/action_rotate"
                    android:title="@string/rotate" />
            </group>

            <!-- Additional Actions -->
            <group android:id="@+id/group_actions">
                <item
                    android:id="@+id/action_properties"
                    android:title="@string/properties" />
                <item
                    android:id="@+id/action_export_text"
                    android:title="@string/export_text" />
            </group>
        </menu>

    </item>

</menu>