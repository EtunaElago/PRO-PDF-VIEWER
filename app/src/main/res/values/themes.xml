<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.ProPdfViewer" parent="Theme.Material3.DayNight">
        <!-- Primary brand colors using PRO brand colors -->
        <item name="colorPrimary">@color/pro_light_red</item>
        <item name="colorPrimaryVariant">@color/pro_brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/pro_light_green</item>
        <item name="colorSecondaryVariant">@color/pro_brand_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_icon_secondary</item>
        
        <!-- Background colors -->
        <item name="colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        
        <!-- Error color -->
        <item name="colorError">@color/color_danger</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Outline color -->
        <item name="colorOutline">@color/color_outline</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:statusBarContrastEnforced">true</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">?attr/colorBackground</item>
        <item name="android:navigationBarDividerColor">@color/color_divider</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:colorBackground">@color/color_background</item>
        
        <!-- Material 3 specific -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.ProPdfViewer</item>
        
        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.ProPdfViewer.Headline1</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.ProPdfViewer.Headline2</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.ProPdfViewer.Title</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.ProPdfViewer.Title</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.ProPdfViewer.Body1</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ProPdfViewer.Body2</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ProPdfViewer.Body1</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ProPdfViewer.Body2</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ProPdfViewer.Caption</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ProPdfViewer.Body1</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ProPdfViewer.Body2</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ProPdfViewer.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ProPdfViewer.Body2</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.ProPdfViewer.Caption</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.ProPdfViewer.Caption</item>
        
        <!-- Component styles -->
        <item name="buttonStyle">@style/Widget.ProPdfViewer.Button.Primary</item>
        <item name="materialButtonStyle">@style/Widget.ProPdfViewer.Button.Primary</item>
        <item name="borderlessButtonStyle">@style/Widget.ProPdfViewer.Button.Secondary</item>
        
        <!-- Card style -->
        <item name="cardViewStyle">@style/Widget.ProPdfViewer.Card</item>
        
        <!-- Toolbar style -->
        <item name="toolbarStyle">@style/Widget.ProPdfViewer.Toolbar</item>
        
        <!-- Bottom navigation style -->
        <item name="bottomNavigationStyle">@style/Widget.ProPdfViewer.BottomNavigation</item>
        
        <!-- Search view style -->
        <item name="searchViewStyle">@style/Widget.ProPdfViewer.SearchView</item>
        
        <!-- Progress bar style -->
        <item name="progressBarStyle">@style/Widget.ProPdfViewer.ProgressBar</item>
        
        <!-- Chip style -->
        <item name="chipStyle">@style/Widget.ProPdfViewer.Chip</item>
        
        <!-- Dialog theme -->
        <item name="alertDialogTheme">@style/Theme.ProPdfViewer.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.ProPdfViewer.Dialog</item>
        
        <!-- Customizations -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">true</item>
        
        <!-- Animation -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.ProPdfViewer</item>
    </style>

    <!-- Light theme -->
    <style name="Theme.ProPdfViewer" parent="Base.Theme.ProPdfViewer">
        <item name="colorPrimary">@color/pro_light_red</item>
        <item name="colorPrimaryVariant">@color/pro_brand_primary</item>
        <item name="colorSecondary">@color/pro_light_green</item>
        <item name="colorSecondaryVariant">@color/pro_brand_secondary</item>
    </style>

    <!-- Dark theme -->
    <style name="Theme.ProPdfViewer.Dark" parent="Base.Theme.ProPdfViewer">
        <item name="colorPrimary">@color/pro_light_red</item>
        <item name="colorPrimaryVariant">@color/pro_brand_primary</item>
        <item name="colorSecondary">@color/pro_light_green</item>
        <item name="colorSecondaryVariant">@color/pro_brand_secondary</item>
        <item name="colorSurface">@color/color_surface_dark</item>
        <item name="colorOnSurface">@color/color_on_surface_dark</item>
        <item name="colorBackground">@color/color_background_dark</item>
        <item name="colorOnBackground">@color/color_on_background_dark</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/color_icon_secondary</item>
        <item name="colorOutline">@color/color_outline_dark</item>
        <item name="android:statusBarColor">@color/color_background_dark</item>
        <item name="android:windowBackground">@color/color_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Theme overlay for customizations -->
    <style name="ThemeOverlay.ProPdfViewer" parent="">
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary</item>
        <item name="colorTertiaryContainer">@color/color_surface_variant</item>
        <item name="colorOnTertiaryContainer">@color/color_on_surface</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.ProPdfViewer.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Dialog theme -->
    <style name="Theme.ProPdfViewer.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_background</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="dialogCornerRadius">20dp</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation.ProPdfViewer</item>
    </style>

    <!-- PDF Viewer theme (fullscreen with dark background) -->
    <style name="Theme.ProPdfViewer.PdfViewer" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/color_pdf_background</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/color_pdf_toolbar</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:statusBarColor">@color/color_pdf_toolbar</item>
        <item name="android:navigationBarColor">@color/color_pdf_toolbar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- No Action Bar theme for fragments -->
    <style name="Theme.ProPdfViewer.NoActionBar" parent="Theme.ProPdfViewer">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Transparent theme for dialogs -->
    <style name="Theme.ProPdfViewer.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

</resources>